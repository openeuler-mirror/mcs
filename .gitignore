# no prequisites
*.d

# no binary and libraries
*.so
*.so.*
*.o
*.lib
*.a
*.symvers
*.order
*.cache

# kernel module compile results
*.mod.c
*.mod*
*.ko
*.cmd
*.tmp_versions/

# ide file and editor files
*.vscode

# no build artifacts
build/

# repo-local default for micrun/qemu oebuild workspace when the user
# does not specify one. This matches ./tmp in the repo, not system /tmp.
/tmp/

.cache/
__pycache__/
.agents/env/*
!.agents/env/.gitkeep
.zcode/
