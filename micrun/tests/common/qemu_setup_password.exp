#!/usr/bin/expect -f
# Drive the oEE passwd-expire first-SSH password change flow.
#
# The standard oEE QEMU image allows an empty root password, so sshpass with
# any non-empty secret works directly.  Some image variants set passwd-expire,
# which turns the first SSH into a keyboard-interactive password change that
# sshpass cannot handle.  This script drives that flow using a password
# supplied via the NEW_PASS environment variable.
#
# Usage:  NEW_PASS=<password> qemu_setup_password.exp [ssh-opts...] <target>
#
# Exit 0 when the password change completes (shell prompt reached).
# Exit non-zero on timeout, auth failure, or unexpected disconnect.

if {![info exists env(NEW_PASS)] || $env(NEW_PASS) eq ""} {
    send_user "ERROR: NEW_PASS environment variable must be set\n"
    exit 1
}

set timeout 45
set new_pass $env(NEW_PASS)
set ssh_args $argv

# A desktop session may export SSH_ASKPASS_REQUIRE=prefer, which makes ssh
# pop a GUI password dialog instead of reading from this script's pty.
# Clear it so the password-change prompts always come to expect.
catch {unset env(SSH_ASKPASS)}
set env(SSH_ASKPASS_REQUIRE) "never"

eval spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 -o PubkeyAuthentication=no {*}$ssh_args

# The oEE root account has an empty password at this stage.  Send an empty
# line for any current/old/generic password prompt, and the new password for
# any new/retype prompt, until we reach a shell or the connection closes.
expect {
    timeout {
        send_user "\nTIMEOUT waiting for password-change prompts\n"
        exit 1
    }
    eof {
        exit 0
    }
    -nocase -re "(current|old|unix )password:" {
        send "\r"
        exp_continue
    }
    -nocase -re "new password:" {
        send "$new_pass\r"
        exp_continue
    }
    -nocase -re "(retype|re-enter|again)" {
        send "$new_pass\r"
        exp_continue
    }
    -nocase "password:" {
        send "\r"
        exp_continue
    }
    -nocase "tokens updated successfully" {
        exp_continue
    }
    -nocase "authentication failure" {
        send_user "\nAuthentication failure\n"
        exit 1
    }
    -re {[\$#] } {
        send "exit\r"
        expect eof
    }
    "Last login" {
        exp_continue
    }
}
