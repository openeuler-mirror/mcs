#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../common/env.sh"
source "${SCRIPT_DIR}/../common/assert.sh"
source "${SCRIPT_DIR}/../common/qemu.sh"

QEMU_SMOKE_LOG_FILE="${QEMU_SMOKE_LOG_FILE:-/tmp/micrun-qemu-smoke.log}"
QEMU_KEEP_RUNNING="${QEMU_KEEP_RUNNING:-false}"
QEMU_AUTO_START="${QEMU_AUTO_START:-true}"
QEMU_SMOKE_XEN_CONFIGS="${QEMU_SMOKE_XEN_CONFIGS:-/etc/xen/qemu-uniproton-xen-xen.cfg /etc/xen/qemu-zephyr-xen-xen.cfg}"

cleanup() {
    if [ "$QEMU_KEEP_RUNNING" != "true" ]; then
        qemu_stop_existing >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

log_test "QEMU smoke validation"

qemu_resolve_assets

if [ "$QEMU_AUTO_START" = "true" ]; then
    qemu_stop_existing
    qemu_start_background "$QEMU_SMOKE_LOG_FILE"
fi

qemu_wait_for_ssh 60 || {
    log_error "qemu guest ssh did not become ready"
    tail -n 200 "$QEMU_SMOKE_LOG_FILE" 2>/dev/null || true
    exit 1
}

# Capture the probe output and assert each component individually. The old
# semicolon chain took its exit code from the LAST command only (xl list), so
# a dead containerd or a wrong-arch image sailed through — the acceptance-1
# "containerd runs and resolves the runtime" claim was never actually checked.
SMOKE_PROBE=$(qemu_local_ssh "echo ok; uname -m; systemctl is-active containerd; command -v containerd-shim-mica-v2; xl list" 2>&1) || {
    log_error "qemu smoke command failed"
    printf '%s\n' "$SMOKE_PROBE"
    tail -n 200 "$QEMU_SMOKE_LOG_FILE" 2>/dev/null || true
    exit 1
}
smoke_probe_assert() {
    local label="$1" pattern="$2"
    if ! printf '%s\n' "$SMOKE_PROBE" | grep -qE "$pattern"; then
        log_error "qemu smoke probe missing ${label} (pattern: ${pattern})"
        printf '%s\n' "$SMOKE_PROBE"
        exit 1
    fi
}
# Constraint 2: the delivery path is AArch64.
smoke_probe_assert "aarch64 guest architecture" '^aarch64$'
# Acceptance 1: containerd must actually be running…
smoke_probe_assert "active containerd" '^active$'
# …and the io.containerd.mica.v2 runtime must resolve to the shim binary on
# PATH (containerd maps the runtime name to containerd-shim-mica-v2; a rootfs
# without the binary would fail every ctr run with "binary not found").
smoke_probe_assert "containerd-shim-mica-v2 on PATH" 'containerd-shim-mica-v2'
# Constraint 3: the host must be running on Xen.
smoke_probe_assert "Xen Domain-0" 'Domain-0'

qemu_local_ssh "xl cpupool-list" >/tmp/micrun-qemu-cpupool-probe.out 2>&1 || {
    log_warn "qemu xen cpupool probe failed (non-fatal; some Xen builds lack cpupool support)"
    cat /tmp/micrun-qemu-cpupool-probe.out 2>/dev/null || true
}

if [ "${QEMU_SMOKE_SKIP_XEN_PROBE}" != "true" ]; then
    qemu_local_ssh "
        set -eu
        probe_cfg=''
        for cfg in ${QEMU_SMOKE_XEN_CONFIGS}; do
            if [ -f \"\$cfg\" ]; then
                probe_cfg=\"\$cfg\"
                break
            fi
        done
        [ -n \"\$probe_cfg\" ] || exit 0
        dom_name=\$(sed -n 's/^name = \"\\(.*\\)\"/\\1/p' \"\$probe_cfg\" | head -1)
        if xl create \"\$probe_cfg\" >/tmp/micrun-qemu-xen-probe.log 2>&1; then
            [ -n \"\$dom_name\" ] && xl destroy \"\$dom_name\" >/dev/null 2>&1 || true
            echo xen-probe-ok
        else
            cat /tmp/micrun-qemu-xen-probe.log
            exit 1
        fi
    " >/tmp/micrun-qemu-xen-probe.out 2>&1 || {
        log_warn "qemu xen launch probe failed (non-fatal; depends on qemu-xen device model)"
        cat /tmp/micrun-qemu-xen-probe.out 2>/dev/null || true
    }
fi

log_success "QEMU guest ssh, containerd, and Xen are reachable"
